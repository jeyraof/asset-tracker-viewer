{
  "name": "asset-tracker-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply asset-tracker-auth --local",
    "db:migrate:remote": "wrangler d1 migrations apply asset-tracker-auth --remote"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.138.0"
  }
}
