{
  // Copy to wrangler.jsonc and fill in the D1 database ids and your custom
  // domain. `pnpm wrangler d1 list` prints the ids.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asset-tracker-viewer",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  // Serve only on the custom domain; disable workers.dev and preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "asset.<domain>", "custom_domain": true }],
  "d1_databases": [
    {
      // Existing asset database. Queried read-only; never written to.
      "binding": "DB",
      "database_name": "asset-tracker-db",
      "database_id": "<asset-tracker-db-uuid>"
    },
    {
      // Viewer-owned auth database (passkeys + challenges).
      "binding": "AUTH_DB",
      "database_name": "asset-tracker-auth",
      "database_id": "<asset-tracker-auth-uuid>",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "RP_NAME": "Asset Tracker",
    // Comma-separated WebAuthn RP IDs / origins. A passkey is bound to the RP ID
    // it was created under; adding a domain later needs a fresh registration.
    "RP_IDS": "asset.<domain>",
    "ORIGINS": "https://asset.<domain>"
  }
}
